---
import { Playground } from "../components/Playground";
import { cases, demoMode } from "../lib/cases";
import "../styles/playground.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Seclai playground</title>
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Lexend:wght@100..900&family=Sora:wght@100..800&display=swap"
    />
  </head>
  <body>
    <main class="page">
      <header class="masthead">
        <img src="/logo.svg" alt="" width="32" height="32" />
        <h1>Seclai playground</h1>
      </header>
      {demoMode && <p class="demo-notice">Showing sample replies. To use real agents, set SECLAI_API_KEY in .env and restart.</p>}
      <!-- client:load, not client:only, so this also proves the components render on the server. -->
      <Playground client:load cases={cases} />
    </main>
  </body>
</html>
